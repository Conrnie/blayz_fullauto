import { useState, useEffect } from 'react';
import { useRouter } from 'next/router';
import Link from 'next/link';
import supabase from '../../lib/supabase';

export default function ReportsList() {
  const router = useRouter();
  const [campaigns, setCampaigns] = useState([]);
  const [loading, setLoading] = useState(true);
  const [generating, setGenerating] = useState(false);
  const [selectedCampaign, setSelectedCampaign] = useState('');
  const [reports, setReports] = useState([]);
  const [allReports, setAllReports] = useState([]);
  const [error, setError] = useState(null);
  const [analysisData, setAnalysisData] = useState(null);
  const [aiData, setAiData] = useState(null);
  const [generationStep, setGenerationStep] = useState(0);
  const [generationSteps, setGenerationSteps] = useState({});
  const [loadingMessageIndex, setLoadingMessageIndex] = useState(0);
  const [messageOpacity, setMessageOpacity] = useState(1);
  const [progressValue, setProgressValue] = useState(0);
  
  // Loading messages to rotate through
  const loadingMessages = [
    "This may take some minutes...",
    "Sometimes good quality takes some time",
    "Already had coffee? ☕",
    "*Using Super Advanced Analysis*",
    "Crunching the numbers...",
    "Finding actionable insights...",
    "Analyzing ad performance...",
    "Magic happening behind the scenes...",
    "AI is doing its thing...",
    "Almost there!",
    "Analyzing conversion patterns...",
    "Discovering audience trends...",
    "Generating campaign recommendations...",
    "Optimizing insights for your business...",
    "Preparing detailed performance metrics...",
    "Comparing with industry benchmarks...",
    "Reading the digital tea leaves... 🍵",
    "Our AI is writing a masterpiece for you...",
    "Making your data beautiful and insightful...",
    "Good reports are worth waiting for!"
  ];

  // Handle message rotation and progress bar
  useEffect(() => {
    if (!generating) return;
    
    // Initialize progress
    setProgressValue(0);
    
    // Increment progress every 150ms for smoother animation
    const progressInterval = setInterval(() => {
      setProgressValue(prevValue => {
        // Cap at 95% to show it's still working until complete
        return prevValue < 95 ? prevValue + 0.3 : prevValue;
      });
    }, 150);
    
    const messageInterval = setInterval(() => {
      // Start fade out
      setMessageOpacity(0);
      
      // Change message and fade in after animation completes
      setTimeout(() => {
        setLoadingMessageIndex((prevIndex) => 
          prevIndex === loadingMessages.length - 1 ? 0 : prevIndex + 1
        );
        setMessageOpacity(1);
      }, 500);
    }, 4000); // Change message every 4 seconds
    
    return () => {
      clearInterval(messageInterval);
      clearInterval(progressInterval);
    };
  }, [generating, loadingMessages.length]);
  
  // Update progress to 100% when we're at the final step
  useEffect(() => {
    if (generationStep === 4) {
      setProgressValue(100);
    }
  }, [generationStep]);
  
  useEffect(() => {
    // Load campaigns and all reports
    async function loadInitialData() {
      try {
        setLoading(true);
        
        // Load campaigns - handle mock client limitations
        let campaignData = [];
        try {
          // Check if we're using the mock client by testing if a method exists
          const query = supabase.from('campaigns').select('id, name');
          
          // Check if order method exists (mock client might not have it)
          if (typeof query.order === 'function') {
            const { data, error } = await query.order('name');
            if (error) throw error;
            campaignData = data || [];
          } else {
            // Fallback for mock client
            console.log('Mock client detected, using fallback for campaigns');
            const { data, error } = await query;
            if (error) throw error;
            campaignData = data || [];
            // Sort manually
            campaignData.sort((a, b) => a.name?.localeCompare(b.name));
          }
        } catch (campaignError) {
          console.error('Error loading campaigns:', campaignError);
          // Provide mock campaign data as a fallback
          campaignData = [
            { id: 'mock-campaign-1', name: 'Mock Campaign 1' },
            { id: 'mock-campaign-2', name: 'Mock Campaign 2' }
          ];
        }
        
        setCampaigns(campaignData);
        // If we have campaigns, select the first one by default for convenience
        if (campaignData.length > 0) {
          setSelectedCampaign(campaignData[0].id);
        }
        
        // Load all reports - handle mock client limitations
        let reportData = [];
        try {
          // Simple query first
          const { data, error } = await supabase
            .from('campaign_reports')
            .select('*');
          
          if (error) throw error;
          reportData = data || [];
          
          // Add mock campaign names since we can't use the join
          reportData = reportData.map(report => ({
            ...report,
            campaigns: { name: getCampaignName(report.campaign_id, campaignData) }
          }));
          
          // Sort manually
          reportData.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
        } catch (reportError) {
          console.error('Error loading reports:', reportError);
          // Default to empty array
        }
        
        setAllReports(reportData);
      } catch (err) {
        console.error('Error loading initial data:', err);
        setError('Failed to load data. Please try again later.');
      } finally {
        setLoading(false);
      }
    }
    
    loadInitialData();
  }, []);
  
  useEffect(() => {
    // Load reports for selected campaign
    if (!selectedCampaign) {
      setReports([]);
      return;
    }
    
    async function loadReports() {
      try {
        const { data, error } = await supabase
          .from('campaign_reports')
          .select('*');
        
        if (error) throw error;
        
        if (data) {
          // Filter manually for the selected campaign
          const filteredData = data.filter(r => r.campaign_id === selectedCampaign);
          // Sort manually
          filteredData.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
          setReports(filteredData);
        }
      } catch (err) {
        console.error('Error loading reports:', err);
        setError('Failed to load reports. Please try again later.');
      }
    }
    
    loadReports();
  }, [selectedCampaign]);
  
  async function generateReport() {
    try {
      // Reset state
      setGenerating(true);
      setError(null);
      setAnalysisData(null);
      setAiData(null);
      setGenerationStep(1);
      
      // Get user information BEFORE calling the API that needs the user ID
      console.log('Fetching user information...');
      const { data: { user }, error: userError } = await supabase.auth.getUser();

      if (userError || !user) {
        console.error('Authentication error:', userError);
        throw new Error('You must be logged in to generate and save reports.');
      }

      // STEP 1: Fetch campaign data
      console.log('Fetching campaign data...');
      
      // If we have a real campaign ID selected, fetch real data
      if (selectedCampaign && selectedCampaign !== 'mock-campaign-id') {
        console.log(`Fetching real data for campaign ID: ${selectedCampaign}`);
        setGenerationStep(2);
        
        // STEP 2: Get AI insights directly from our enhanced endpoint
        console.log('Generating AI insights with Gemini...');
        const aiResponse = await fetch('/api/generate-campaign-report', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            campaignId: selectedCampaign,
            userId: user.id
          })
        });
        
        if (!aiResponse.ok) {
          const errorData = await aiResponse.json();
          throw new Error(errorData.error || 'Failed to generate AI insights');
        }
        
        // Get the report ID and redirect
        const aiResponseData = await aiResponse.json();
        console.log('AI insights generated, response:', aiResponseData);
        
        if (!aiResponseData.report_id) {
          throw new Error('No report ID returned from AI generation API');
        }
        
        console.log('Report generated successfully with ID:', aiResponseData.report_id);
        setGenerationStep(4);
        
        // Redirect to the report
        router.push(`/reports/${aiResponseData.report_id}`);
        
      } else {
        // Use test_campaign_4197 data instead of mock data
        console.log('Using test_campaign_4197 data as default');
        setGenerationStep(2);
        
        // STEP 2: Get AI insights directly from our enhanced endpoint
        console.log('Generating AI insights with Gemini...');
        const aiResponse = await fetch('/api/generate-campaign-report', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            campaignId: 'test_campaign_4197',  // Use test_campaign_4197 instead of mock-campaign-id
            userId: user.id
          })
        });
        
        if (!aiResponse.ok) {
          const errorData = await aiResponse.json();
          throw new Error(errorData.error || 'Failed to generate AI insights');
        }
        
        // Get the report ID and redirect
        const aiResponseData = await aiResponse.json();
        console.log('AI insights generated, response:', aiResponseData);
        
        if (!aiResponseData.report_id) {
          throw new Error('No report ID returned from AI generation API');
        }
        
        console.log('Report generated successfully with ID:', aiResponseData.report_id);
        setGenerationStep(4);
        
        // Redirect to the report
        router.push(`/reports/${aiResponseData.report_id}`);
      }
      
      return;
    } catch (err) {
      console.error('Error generating report:', err);
      setError(err.message || 'Failed to generate report');
    } finally {
      if (!error) {
        // Only reset if no error occurred
        setTimeout(() => {
          setGenerating(false);
          setGenerationStep(0);
        }, 1000);
      } else {
        setGenerating(false);
        setGenerationStep(0);
      }
    }
  }
  
  // Format date for display
  function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }
  
  // Get campaign name from ID
  function getCampaignName(campaignId, campaignsList = campaigns) {
    if (campaignId === 'mock-campaign-id') return 'Mock Campaign Data';
    if (campaignId === 'mock-campaign-1') return 'Mock Campaign 1';
    if (campaignId === 'mock-campaign-2') return 'Mock Campaign 2';
    
    const campaign = campaignsList.find(c => c.id === campaignId);
    return campaign ? campaign.name : campaignId;
  }
  
  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
      {/* Top wave decoration */}
      <div className="absolute top-0 left-0 right-0 h-64 overflow-hidden -z-10 opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" className="w-full h-full">
          <path fill="#FFF5E9" fillOpacity="1" d="M0,224L48,213.3C96,203,192,181,288,160C384,139,480,117,576,122.7C672,128,768,160,864,186.7C960,213,1056,235,1152,213.3C1248,192,1344,128,1392,96L1440,64L1440,0L1392,0C1344,0,1248,0,1152,0C1056,0,960,0,864,0C768,0,672,0,576,0C480,0,384,0,288,0C192,0,96,0,48,0L0,0Z"></path>
        </svg>
      </div>
      
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16 relative">
        {/* Header section */}
        <div className="max-w-3xl mx-auto mb-12 text-center">
          <h1 className="text-4xl md:text-5xl font-extrabold text-secondary mb-4 tracking-tight">
            Campaign Reports
            <span className="block text-primary mt-1 text-5xl md:text-6xl">Insights</span>
          </h1>
          <p className="mt-3 max-w-md mx-auto text-xl text-gray-600">
            Discover actionable insights to optimize your ad campaigns.
          </p>
        </div>
        
        {error && (
          <div className="max-w-3xl mx-auto mb-8 flex p-4 text-red-800 rounded-lg bg-red-50 border-l-4 border-red-500" role="alert">
            <svg className="flex-shrink-0 w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm1-4a1 1 0 0 1-2 0V6a1 1 0 0 1 2 0v5Z"/>
            </svg>
            <span className="font-medium">{error}</span>
          </div>
        )}
        
        {/* Card section with max width for better readability */}
        <div className="max-w-3xl mx-auto space-y-8">
          {/* Generate Report Card */}
          <div className="bg-white rounded-2xl shadow-xl overflow-hidden transform transition-all">
            {/* Card Header */}
            <div className="relative overflow-hidden">
              <div className="bg-gradient-to-r from-primary/90 to-primary px-8 py-6 text-white">
                <div className="flex items-center justify-between">
                  <div>
                    <h2 className="text-2xl font-bold text-white">Generate New Report</h2>
                    <p className="mt-1 text-white/90">
                      AI-powered analysis of your campaign performance
                    </p>
                  </div>
                  <div className="hidden sm:block">
                    <svg xmlns="http://www.w3.org/2000/svg" className="h-16 w-16 text-white/20" viewBox="0 0 20 20" fill="currentColor">
                      <path fillRule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 6a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V8z" clipRule="evenodd" />
                    </svg>
                  </div>
                </div>
              </div>
              
              {/* Decorative pattern */}
              <div className="absolute top-0 right-0 -mt-6 -mr-6 h-24 w-24 rounded-full bg-white/10 blur-xl"></div>
              <div className="absolute bottom-0 left-0 -mb-6 -ml-6 h-16 w-16 rounded-full bg-white/10 blur-xl"></div>
            </div>
            
            {/* Card Body */}
            <div className="px-8 py-6">
              <div className="grid sm:grid-cols-4 gap-6">
                <div className="sm:col-span-3">
                  {loading ? (
                    <div className="flex items-center space-x-3 bg-gray-50 p-4 rounded-lg animate-pulse">
                      <div className="w-6 h-6 bg-gray-300 rounded-full animate-spin"></div>
                      <span className="text-gray-600">Loading campaigns...</span>
                    </div>
                  ) : campaigns.length > 0 ? (
                    <div className="space-y-3">
                      <label className="block text-sm font-medium text-gray-700">
                        Select Campaign
                      </label>
                      <div className="relative">
                        <select
                          className="block w-full rounded-lg border-gray-300 shadow-sm focus:border-primary focus:ring focus:ring-primary/20 transition-all py-3 px-4 bg-white text-gray-700 appearance-none"
                          value={selectedCampaign}
                          onChange={(e) => setSelectedCampaign(e.target.value)}
                          disabled={generating}
                        >
                          <option value="">-- Use Demo Data --</option>
                          {campaigns.map(campaign => (
                            <option key={campaign.id} value={campaign.id}>
                              {campaign.name}
                            </option>
                          ))}
                        </select>
                        <div className="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-700">
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fillRule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clipRule="evenodd" />
                          </svg>
                        </div>
                      </div>
                      <p className="text-xs text-gray-500 flex items-center space-x-1">
                        <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 text-primary" viewBox="0 0 20 20" fill="currentColor">
                          <path fillRule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clipRule="evenodd" />
                        </svg>
                        <span>Select your campaign or use demo data for testing</span>
                      </p>
                    </div>
                  ) : (
                    <div className="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-4 border border-blue-100">
                      <div className="flex items-start">
                        <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 text-blue-600 mt-0.5 mr-3" viewBox="0 0 20 20" fill="currentColor">
                          <path fillRule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clipRule="evenodd" />
                        </svg>
                        <p className="text-sm text-gray-700">
                          Using demo data for campaign analysis. This gives you a sample of the insights you'll get from your own campaigns.
                        </p>
                      </div>
                    </div>
                  )}
                </div>
                
                <div className="sm:col-span-1 flex flex-col justify-end">
                  <button
                    onClick={generateReport}
                    disabled={generating}
                    className={`relative overflow-hidden w-full py-3 px-4 rounded-lg font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all ${
                      generating 
                        ? 'bg-gray-300 text-gray-500 cursor-not-allowed' 
                        : 'bg-gradient-to-r from-primary to-primary/90 text-white shadow-md hover:shadow-lg hover:from-primary/90 hover:to-primary'
                    }`}
                  >
                    {generating ? 'Generating...' : 'Generate Report'}
                    {!generating && (
                      <span className="absolute top-0 right-0 -mt-3 -mr-3 h-8 w-8 rounded-full bg-white/30 flex items-center justify-center opacity-70">
                        <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                          <path fillRule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clipRule="evenodd" />
                        </svg>
                      </span>
                    )}
                  </button>
                </div>
              </div>
              
              {generating && (
                <div className="mt-12 mb-6 relative">
                  {/* Custom spinner with brand colors */}
                  <div className="flex flex-col items-center justify-center text-center">
                    <div className="relative animate-pulse-slow">
                      <div className="w-24 h-24 rounded-full border-t-4 border-b-4 border-primary animate-spin"></div>
                      <div className="absolute top-0 left-0 right-0 bottom-0 flex items-center justify-center">
                        <div className="w-16 h-16 rounded-full bg-white shadow-inner"></div>
                      </div>
                      <div className="absolute top-0 left-0 right-0 bottom-0 flex items-center justify-center">
                        <div className="w-12 h-12 rounded-full bg-gradient-to-br from-primary/20 to-primary/10 animate-ping"></div>
                      </div>
                      <div className="absolute top-0 left-0 right-0 bottom-0 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6 text-primary" viewBox="0 0 20 20" fill="currentColor">
                          <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v3.586L7.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l3-3a1 1 0 00-1.414-1.414L11 10.586V7z" clipRule="evenodd" />
                        </svg>
                      </div>
                    </div>
                    
                    <div 
                      className="mt-8 text-lg transition-all duration-500 ease-in-out backdrop-blur-sm bg-white/80 p-6 rounded-xl shadow-lg max-w-md mx-auto border border-gray-100"
                      style={{ opacity: messageOpacity }}
                    >
                      <p className="font-medium text-gray-800">{loadingMessages[loadingMessageIndex]}</p>
                    </div>
                    
                    {/* Progress steps */}
                    <div className="w-full max-w-md mt-10">
                      <div className="relative">
                        <div className="overflow-hidden h-2 text-xs flex rounded-full bg-gray-200">
                          <div 
                            className="shadow-lg rounded-full bg-gradient-to-r from-primary/80 to-primary transition-all duration-300 ease-out relative flex items-center justify-center"
                            style={{ width: `${progressValue}%` }}
                          >
                            <div className="absolute inset-0 bg-white/20 rounded-full animate-pulse"></div>
                          </div>
                        </div>
                        
                        {/* Step indicators */}
                        <div className="flex items-center justify-between -mt-2">
                          <div className={`rounded-full h-6 w-6 flex items-center justify-center ${
                            progressValue >= 30 ? 'bg-primary text-white' : 'bg-gray-200 text-gray-600'
                          }`}>
                            <span className="text-xs font-medium">1</span>
                          </div>
                          <div className={`rounded-full h-6 w-6 flex items-center justify-center ${
                            progressValue >= 60 ? 'bg-primary text-white' : 'bg-gray-200 text-gray-600'
                          }`}>
                            <span className="text-xs font-medium">2</span>
                          </div>
                          <div className={`rounded-full h-6 w-6 flex items-center justify-center ${
                            progressValue >= 90 ? 'bg-primary text-white' : 'bg-gray-200 text-gray-600'
                          }`}>
                            <span className="text-xs font-medium">3</span>
                          </div>
                        </div>
                        
                        {/* Step labels */}
                        <div className="flex text-xs font-medium text-gray-600 justify-between px-1 mt-2">
                          <span>Collecting data</span>
                          <span>Analyzing</span>
                          <span>Generating</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
          
          {/* Previous Reports Card */}
          {selectedCampaign && (
            <div className="bg-white rounded-2xl shadow-xl overflow-hidden">
              <div className="bg-gradient-to-r from-[#1E293B] to-[#334155] px-8 py-6 text-white">
                <div className="flex justify-between items-center">
                  <h2 className="text-xl font-bold text-white">
                    {getCampaignName(selectedCampaign)} <span className="text-primary">Reports</span>
                  </h2>
                  <span className="bg-primary/20 text-white px-3 py-1 rounded-full text-xs font-medium">
                    Campaign Selected
                  </span>
                </div>
              </div>
              
              <div className="p-6">
                {reports.length === 0 ? (
                  <div className="flex flex-col items-center justify-center text-center py-8 px-4">
                    <div className="bg-gray-100 rounded-full p-3 mb-4">
                      <svg xmlns="http://www.w3.org/2000/svg" className="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <h3 className="text-lg font-medium text-gray-900">No Reports Found</h3>
                    <p className="mt-2 text-sm text-gray-600">
                      Generate your first report for this campaign to get started.
                    </p>
                  </div>
                ) : (
                  <div className="overflow-x-auto">
                    <table className="min-w-full divide-y divide-gray-200">
                      <thead>
                        <tr>
                          <th className="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Generated On
                          </th>
                          <th className="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Actions
                          </th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-200 bg-white">
                        {reports.map(report => (
                          <tr key={report.id} className="hover:bg-gray-50 transition-colors">
                            <td className="px-6 py-4 whitespace-nowrap">
                              <div className="flex items-center">
                                <div className="flex-shrink-0 h-10 w-10 rounded-md bg-[#FFF5E9] flex items-center justify-center">
                                  <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                                    <path fillRule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm2 10a1 1 0 10-2 0v3a1 1 0 102 0v-3zm2-3a1 1 0 011 1v5a1 1 0 11-2 0v-5a1 1 0 011-1zm4-1a1 1 0 10-2 0v7a1 1 0 102 0V8z" clipRule="evenodd" />
                                  </svg>
                                </div>
                                <div className="ml-4">
                                  <div className="text-sm font-medium text-gray-900">
                                    {formatDate(report.created_at)}
                                  </div>
                                  <div className="text-xs text-gray-500">
                                    Report #{report.id.substring(0, 8)}
                                  </div>
                                </div>
                              </div>
                            </td>
                            <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                              <Link href={`/reports/${report.id}`} legacyBehavior>
                                <a className="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary">
                                  <svg xmlns="http://www.w3.org/2000/svg" className="-ml-1 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                                    <path fillRule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clipRule="evenodd" />
                                  </svg>
                                  View Report
                                </a>
                              </Link>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            </div>
          )}
          
          {/* All Reports Card */}
          <div className="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div className="bg-gradient-to-r from-gray-800 to-gray-900 px-8 py-6 text-white">
              <h2 className="text-xl font-bold text-white flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6 mr-2 text-primary" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
                </svg>
                All Campaign Reports
              </h2>
            </div>
            
            <div className="p-6">
              {loading ? (
                <div className="flex justify-center py-8">
                  <div className="flex items-center space-x-3">
                    <div className="animate-spin rounded-full h-6 w-6 border-t-2 border-b-2 border-primary"></div>
                    <span className="text-gray-500">Loading reports...</span>
                  </div>
                </div>
              ) : (
                <div className="overflow-x-auto">
                  {allReports.length === 0 ? (
                    <div className="text-center py-10 px-4">
                      <svg xmlns="http://www.w3.org/2000/svg" className="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1} d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <h3 className="mt-2 text-sm font-medium text-gray-900">No reports</h3>
                      <p className="mt-1 text-sm text-gray-500">
                        Get started by generating your first report.
                      </p>
                      <div className="mt-6">
                        <button
                          onClick={generateReport}
                          type="button"
                          className="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="-ml-1 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                            <path fillRule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clipRule="evenodd" />
                          </svg>
                          Generate a report
                        </button>
                      </div>
                    </div>
                  ) : (
                    <div className="shadow overflow-hidden border border-gray-100 sm:rounded-lg">
                      <table className="min-w-full divide-y divide-gray-200">
                        <thead className="bg-gray-50">
                          <tr>
                            <th scope="col" className="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                              Date
                            </th>
                            <th scope="col" className="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                              Campaign
                            </th>
                            <th scope="col" className="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">
                              Actions
                            </th>
                          </tr>
                        </thead>
                        <tbody className="bg-white divide-y divide-gray-200">
                          {allReports.map(report => (
                            <tr key={report.id} className="hover:bg-gray-50 transition-colors">
                              <td className="px-6 py-4 whitespace-nowrap">
                                <div className="text-sm text-gray-900">{formatDate(report.created_at)}</div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap">
                                <div className="flex items-center">
                                  <div className="flex-shrink-0 h-8 w-8 rounded-full bg-primary/10 flex items-center justify-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 text-primary" viewBox="0 0 20 20" fill="currentColor">
                                      <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" />
                                    </svg>
                                  </div>
                                  <div className="ml-3">
                                    <div className="text-sm font-medium text-gray-900">
                                      {report.campaign_id === 'mock-campaign-id' 
                                        ? 'Demo Campaign Data' 
                                        : (report.campaigns?.name || getCampaignName(report.campaign_id))}
                                    </div>
                                  </div>
                                </div>
                              </td>
                              <td className="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <Link href={`/reports/${report.id}`} legacyBehavior>
                                  <a className="text-primary hover:text-primary/80 font-medium hover:underline inline-flex items-center">
                                    View Report
                                    <svg xmlns="http://www.w3.org/2000/svg" className="ml-1.5 h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                      <path fillRule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clipRule="evenodd" />
                                    </svg>
                                  </a>
                                </Link>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
      
      {/* Footer decoration */}
      <div className="absolute bottom-0 left-0 right-0 h-32 overflow-hidden -z-10 opacity-70">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" className="w-full h-full">
          <path fill="#FFF5E9" fillOpacity="1" d="M0,224L48,213.3C96,203,192,181,288,160C384,139,480,117,576,122.7C672,128,768,160,864,186.7C960,213,1056,235,1152,213.3C1248,192,1344,128,1392,96L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
        </svg>
      </div>
    </div>
  );
}
